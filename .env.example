# Local Pros — browser-safe Supabase configuration plus server-only integration placeholders.
# Use a publishable key. NEVER place a Supabase secret/service-role key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://zbsdbqdvmlatlklwjiuh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Directory instance configuration. Central Illinois values remain the code fallback,
# but every replicated Local Pros deployment should set these explicitly.
NEXT_PUBLIC_DIRECTORY_TENANT_ID=6673621d-b359-4c17-a984-c8f50d914eb3
NEXT_PUBLIC_DIRECTORY_TENANT_SLUG=central-illinois-local-pros
NEXT_PUBLIC_DIRECTORY_NAME=Central Illinois Local Pros
NEXT_PUBLIC_DIRECTORY_REGION=Central Illinois
NEXT_PUBLIC_PARENT_BRAND_NAME=Skylight Reflections Marketing
NEXT_PUBLIC_DIRECTORY_HERO_EYEBROW=Central Illinois Business Directory
NEXT_PUBLIC_DIRECTORY_HERO_SUBTITLE=Find home-service professionals, attorneys, restaurants, local stores and independent local service providers across Central Illinois. Compare local profiles and connect directly.

# Server-only Stripe credential used to create dynamic one-time paid-lead Checkout sessions and lead invoices.
# NEVER prefix this with NEXT_PUBLIC_ and never commit a real value.
STRIPE_SECRET_KEY=

# Optional lead-delivery email notifications (in-app notifications work without this).
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM_EMAIL=

# Optional lead-delivery SMS notifications (in-app notifications work without this).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Server-only Canva Connect OAuth credentials.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/admin/marketing/canva/callback

# Reserved server-only Meta publishing connector credentials.
META_APP_ID=
META_APP_SECRET=

# Optional one-time local/operator note only; this app does not consume a Supabase service-role key.
